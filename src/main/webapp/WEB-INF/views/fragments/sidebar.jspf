<%
    Object navUser = session.getAttribute("user");
    String navRole = (navUser instanceof clinicmanagement.model.User)
            ? ((clinicmanagement.model.User) navUser).getRole().name()
            : "";
    boolean navAdmin = "ADMIN".equals(navRole) || "STAFF".equals(navRole);
    boolean navDoctor = "DOCTOR".equals(navRole);
    boolean navPatient = "PATIENT".equals(navRole);
    String navCtx = request.getContextPath();
%>
<aside id="sidebar"
       class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-ink-200 bg-white transition-transform duration-200 ease-out lg:static lg:z-auto lg:translate-x-0"
       aria-label="Main navigation">

  <div class="flex h-14 shrink-0 items-center gap-2 border-b border-ink-200 px-4">
    <a href="<%= navCtx %>/" class="flex items-center gap-2 rounded-lg px-1 py-1">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-primary-600 text-lg font-bold text-white" aria-hidden="true">+</span>
      <span class="text-base font-semibold tracking-tight text-ink-900">Clinic<span class="text-primary-700">Manager</span></span>
    </a>
  </div>

  <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-3">

    <a class="nav-link <%= "dashboard".equals(activeNav) ? "nav-link-active" : "" %>" href="<%= navCtx %>/">
      <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5"/></svg>
      Dashboard
    </a>

    <% if (navAdmin) { %>
      <p class="nav-section">Administration</p>
      <a class="nav-link <%= "departments".equals(activeNav) ? "nav-link-active" : "" %>" href="<%= navCtx %>/departments">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>
        Departments
      </a>
      <a class="nav-link <%= "doctors".equals(activeNav) ? "nav-link-active" : "" %>" href="<%= navCtx %>/doctors/list">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 0c-3.5 0-6 2-6 5v3h12v-3c0-3-2.5-5-6-5Z"/></svg>
        Doctors
      </a>
    <% } %>

    <% if (navAdmin || navDoctor) { %>
      <p class="nav-section">Scheduling</p>
      <a class="nav-link <%= "appointments".equals(activeNav) ? "nav-link-active" : "" %>" href="<%= navCtx %>/appointments/list">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 3v3m10-3v3M4 8h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm3 8h3m4 0h1m-8 4h3m4 0h1"/></svg>
        Appointments
      </a>
      <a class="nav-link <%= "availabilities".equals(activeNav) ? "nav-link-active" : "" %>" href="<%= navCtx %>/availabilities">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
        Availabilities
      </a>
    <% } %>

    <% if (navPatient) { %>
      <p class="nav-section">My health</p>
      <a class="nav-link <%= "patient-register".equals(activeNav) ? "nav-link-active" : "" %>" href="<%= navCtx %>/patients/register">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/></svg>
        Patient registration
      </a>
      <a class="nav-link <%= "my-profile".equals(activeNav) ? "nav-link-active" : "" %>" href="<%= navCtx %>/patients/profile?id=${sessionScope.user.id}">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM4 21a8 8 0 0 1 16 0"/></svg>
        My profile
      </a>
    <% } %>

  </nav>

  <div class="shrink-0 border-t border-ink-200 p-3">
    <div class="flex items-center gap-3 rounded-lg bg-ink-50 px-3 py-2">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-primary-100 text-sm font-semibold text-primary-700" aria-hidden="true">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 0c-3.5 0-6 2-6 5v3h12v-3c0-3-2.5-5-6-5Z"/></svg>
      </span>
      <div class="min-w-0">
        <p class="truncate text-sm font-semibold text-ink-900">${sessionScope.user.prenom} ${sessionScope.user.nom}</p>
        <span class="badge badge-role"><%= navRole %></span>
      </div>
    </div>
  </div>
</aside>
<div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-ink-900/40 lg:hidden"></div>
