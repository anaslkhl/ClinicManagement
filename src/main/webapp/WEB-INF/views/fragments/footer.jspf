<dialog id="confirm-dialog"
        class="m-auto w-[min(92vw,26rem)] rounded-2xl border border-ink-200 bg-white p-0 shadow-card">
  <form method="dialog" class="p-5" onsubmit="return false;">
    <div class="flex items-start gap-3">
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-danger-50 text-danger-600" aria-hidden="true">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
      </span>
      <div class="min-w-0">
        <h2 id="confirm-title" class="text-base font-semibold text-ink-900">Please confirm</h2>
        <p id="confirm-message" class="mt-1 text-sm text-ink-500">Are you sure?</p>
      </div>
    </div>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" id="confirm-cancel" class="btn btn-secondary">Cancel</button>
      <button type="button" id="confirm-ok" class="btn btn-danger">Confirm</button>
    </div>
  </form>
</dialog>

<div id="toast-region" class="fixed bottom-4 right-4 z-50 flex w-[min(92vw,22rem)] flex-col gap-2" aria-live="polite" aria-atomic="true"></div>

<script src="<%= request.getContextPath() %>/js/app.js" defer></script>
<style>
  #confirm-dialog::backdrop { background: rgba(15,23,42,.45); }
  #confirm-dialog[open] { animation: toast-in .15s ease-out; }
</style>
</body>
</html>
